# JARVIS HUD settings.
# After changing anything here, choose JARVIS HUD ▸ Restart JARVIS.

# ── Voice ──────────────────────────────────────────────────────
# With no key JARVIS speaks with the Mac's built-in voice. Add a Fish Audio key
# (fish.audio) and a voice id and it speaks through Fish Audio instead.
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_ID=
# FISH_AUDIO_LATENCY=balanced

# ── Claude ─────────────────────────────────────────────────────
# JARVIS answers through your Claude subscription: sign in from the Brain
# read-out at the top right of the window. Never set ANTHROPIC_API_KEY here;
# that would bill per token instead of using your plan.
#
# As installed, Claude can answer, search the web, and use the vault and
# long-term memory. It cannot run commands or change files on this Mac:
# JARVIS_TOOLS is the complete list of tools it is given.
JARVIS_PERMISSION=default
JARVIS_TOOLS=WebSearch,WebFetch
JARVIS_MCP=off
JARVIS_TIMEOUT=180
# JARVIS_MODEL=opus

# ── Listening ──────────────────────────────────────────────────
# Live voice needs something to turn speech into text: local whisper.cpp
# (brew install whisper-cpp ffmpeg, plus a ggml model) or a Fish Audio key.
JARVIS_STT=auto

# ── Memory + server ────────────────────────────────────────────
# auto = remember when asked and when you share something lasting;
# ask = only when asked; off = no long-term memory.
JARVIS_MEMORY=auto
JARVIS_PORT=8720
JARVIS_DEMO=0
# Point JARVIS at your own notes instead of the sample vault:
# JARVIS_VAULT=~/Documents/ObsidianVault
