# ── Voice (Step 2 of the build) ────────────────────────────────
# Leave blank and JARVIS uses the browser's robotic speechSynthesis voice.
# Add a key and it speaks through Fish Audio instead.
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
# Paste a cloned/library voice id here once you have one.
FISH_AUDIO_VOICE_ID=
# How soon Fish starts sending audio. "balanced" streams it as it is synthesised,
# so JARVIS starts speaking about half a second after a sentence is written.
# "normal" renders the whole clip first: seconds slower per sentence.
# FISH_AUDIO_LATENCY=balanced

# ── Brain ──────────────────────────────────────────────────────
# Uses your Claude Code subscription. Never set --bare; it forces API-key auth.
# JARVIS_MODEL=opus
# CLAUDE_CMD=/absolute/path/to/claude
# Permission mode passed to `claude -p`. Defaults to bypassPermissions so JARVIS
# can actually use every tool — Gmail, Calendar, Drive, web search, shell, file
# edits — with NO confirmation. A headless run can't show you a permission
# prompt, so anything stricter silently blocks those tools. Trade-off: JARVIS can
# also send email, delete data, and run shell commands unattended, driven by what
# it hears. Set this to acceptEdits (edits only) for a tighter blast radius.
JARVIS_PERMISSION=bypassPermissions
# The complete list of tools Claude is given (default: all of them), and
# whether your connected MCP servers are loaded. The Mac app ships with
# JARVIS_PERMISSION=default, JARVIS_TOOLS=WebSearch,WebFetch, JARVIS_MCP=off.
# JARVIS_TOOLS=WebSearch,WebFetch
# JARVIS_MCP=off
JARVIS_TIMEOUT=180

# ── Listening ──────────────────────────────────────────────────
# Local whisper.cpp is used automatically when available: free, offline, and it
# works in Brave (the browser recogniser needs Google's service, which Brave
# ships without). Fish Audio ASR is billed separately from TTS and is only used
# if whisper is missing. Force one with JARVIS_STT=whisper|fish.
# WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# WHISPER_MODEL=~/.clawbot/models/ggml-base.bin
# WHISPER_LANG=auto
JARVIS_STT=auto

# ── Memory + server ────────────────────────────────────────────
# Long-term memory: what JARVIS is told to remember is kept as notes in
# vault/memory/ and survives restarts. auto = save when asked and when you share
# something lasting; ask = only when asked; off = no long-term memory.
JARVIS_MEMORY=auto
# JARVIS_VAULT=~/Documents/ObsidianVault
JARVIS_WORKDIR=~
JARVIS_PORT=8720
JARVIS_OPEN=1
JARVIS_DEMO=1
